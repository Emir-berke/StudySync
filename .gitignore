
# ==========================================
# StudySync - Main .gitignore
# ==========================================

# Node.js dependencies
node_modules/
**/node_modules/

# Environment variables and secrets
.env
.env.*
**/.env
**/.env.*

# Allow safe environment templates
!.env.example
!**/.env.example

# Private credential files
envfiles.txt

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Build output
dist/
**/dist/
build/
**/build/
coverage/
**/coverage/

# Temporary files
*.tmp
*.temp
*.local

# Operating system files
.DS_Store
Thumbs.db

# Editor files
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.swp
*.swo

# Test output
.nyc_output/

# Local backups
*.bak
*.backup
